V "GNAT Lib v15"
M P W=b
A -gnatA
A -gnat2012
A -gnato
A -gnatwa
A -gnata
A -g
A -mmacosx-version-min=14.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

RN
RV NO_ACCESS_SUBPROGRAMS
RV NO_ALLOCATORS
RV NO_CALENDAR
RV NO_DELAY
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_EXCEPTION_HANDLERS
